# PROTAC prep artifacts. run_protac_docking.py writes these into its --input-dir,
# which now defaults to the bundled example, so a bare run would otherwise leave
# untracked files inside examples/.
examples/protac_docking/**/protac_ligand.dms
examples/protac_docking/**/protac_receptor.dms
examples/protac_docking/**/protac_temp_cursor.sdf
